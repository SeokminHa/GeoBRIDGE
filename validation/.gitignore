# Data — never commit
data/raw/**
data/interim/**
!data/raw/.gitkeep
!data/interim/.gitkeep

# GT files are allowed if small (DoRothEA is ~5MB). Exclude big ones.
data/gt/**.bed
data/gt/**.bam
data/gt/**.loom
data/gt/**.h5ad

# Results / logs
results/**
logs/**
!results/.gitkeep
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large binaries
*.loom
*.h5ad
*.parquet
!configs/**
